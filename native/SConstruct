#!/usr/bin/env python
# Compila la GDExtension DesktopNative.
#   cd native && scons platform=windows target=template_debug
#   cd native && scons platform=windows target=template_release
import os

env = SConscript("godot-cpp/SConstruct")
env.Append(CPPPATH=["src/"])
if env["platform"] == "windows":
    env.Append(LIBS=["user32", "shell32", "ole32"])

sources = Glob("src/*.cpp")
out_dir = "../addons/desktop_native/bin/"
library = env.SharedLibrary(
    out_dir + "desktop_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
